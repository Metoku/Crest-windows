<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CrestWindows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Crest Windows Preview">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="RootLayout" ColumnSpacing="0">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="Shortcut_NewTab"/>
            <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="Shortcut_CloseTab"/>
            <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="Shortcut_FocusAddress"/>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="Shortcut_FocusAddress"/>
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="Shortcut_Reload"/>
            <KeyboardAccelerator Key="Tab" Modifiers="Control" Invoked="Shortcut_NextTab"/>
            <KeyboardAccelerator Key="Tab" Modifiers="Control, Shift" Invoked="Shortcut_PreviousTab"/>
            <KeyboardAccelerator Key="J" Modifiers="Control" Invoked="Shortcut_Downloads"/>
        </Grid.KeyboardAccelerators>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="12" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Crest Preview" FontSize="21" FontWeight="SemiBold" Margin="6,8,0,4" />
            <ComboBox x:Name="SpaceBox" Grid.Row="1" Header="Space" HorizontalAlignment="Stretch"
                      SelectionChanged="SpaceBox_SelectionChanged" />
            <StackPanel x:Name="PinnedPanel" Grid.Row="2" Visibility="Collapsed" Spacing="4" Padding="0,6,0,8">
                <TextBlock Text="FAVORITES" FontSize="11" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="8,0,0,0"/>
                <GridView x:Name="PinnedList" SelectionMode="Single" MaxHeight="260"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          CanDragItems="True" CanReorderItems="False" AllowDrop="True"
                          DragItemsStarting="Sidebar_DragItemsStarting"
                          DragItemsCompleted="Sidebar_DragItemsCompleted"
                          DragOver="Sidebar_DragOver" Drop="Sidebar_Drop"
                          RightTapped="TabList_RightTapped"
                          SelectionChanged="PinnedList_SelectionChanged">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="55" Spacing="3" ToolTipService.ToolTip="{Binding Label}">
                                <Border Width="41" Height="41" CornerRadius="9"
                                        HorizontalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Grid>
                                        <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding FallbackVisibility}"/>
                                        <Image Source="{Binding Favicon}" Width="16" Height="16"
                                               UseLayoutRounding="True"
                                               Stretch="Uniform" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding FaviconVisibility}"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Label}" MaxLines="1"
                                           FontSize="10" TextTrimming="CharacterEllipsis"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
            <ListView x:Name="TabList" Grid.Row="3"
                      SelectionChanged="TabList_SelectionChanged"
                      RightTapped="TabList_RightTapped"
                      CanDragItems="True" CanReorderItems="False" AllowDrop="True"
                      DragItemsStarting="Sidebar_DragItemsStarting"
                      DragItemsCompleted="Sidebar_DragItemsCompleted"
                      DragOver="Sidebar_DragOver" Drop="Sidebar_Drop"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="{Binding Indent}"
                                    ToolTipService.ToolTip="{Binding Label}">
                            <Grid Width="18" Height="18">
                                <FontIcon Glyph="{Binding Glyph}" FontSize="15"
                                          Visibility="{Binding FallbackVisibility}"/>
                                <Image Source="{Binding Favicon}" Width="16" Height="16"
                                       Stretch="Uniform" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding FaviconVisibility}"/>
                            </Grid>
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid Grid.Row="4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="+ Tab" Click="NewTab_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                <Button Grid.Column="1" Content="+ Folder" Click="NewFolder_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            </Grid>
        </Grid>
        <Grid Grid.Column="1" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#x2190;" Click="Back_Click" ToolTipService.ToolTip="Back"/>
                <Button Grid.Column="1" Content="&#x2192;" Click="Forward_Click" ToolTipService.ToolTip="Forward"/>
                <Button Grid.Column="2" Content="&#x21BB;" Click="Reload_Click" ToolTipService.ToolTip="Reload"/>
                <TextBox x:Name="UrlBox" Grid.Column="3" PlaceholderText="Search or enter an address"
                         KeyDown="UrlBox_KeyDown"/>
                <Button Grid.Column="4" Content="Go" Click="Go_Click" />
                <Button x:Name="HistoryButton" Grid.Column="5" Content="History" Click="History_Click" />
                <Button x:Name="SplitButton" Grid.Column="6" Content="Split" Click="SplitButton_Click"
                        ToolTipService.ToolTip="Show two Open tabs side by side" />
                <Button x:Name="DownloadsButton" Grid.Column="7" Content="Downloads"
                        ToolTipService.ToolTip="Downloads in this Space">
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Width="390" Spacing="9" Loaded="DownloadsPanel_Loaded">
                                <TextBlock Text="Downloads" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock x:Name="NoDownloadsText"
                                           Text="No regular file downloads tracked in this Space."
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="Save Page As uses WebView2's separate saved-page manager."
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Button Content="View saved pages and browser downloads"
                                        Click="ShowBrowserDownloads_Click"
                                        ToolTipService.ToolTip="Open the WebView2 downloads list for this Space"/>
                                <ListView x:Name="DownloadsList" SelectionMode="None"
                                          MaxHeight="420" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="5" Padding="3,6,3,6">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1" ToolTipService.ToolTip="{Binding FilePath}"/>
                                                <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap"/>
                                                <ProgressBar Minimum="0" Maximum="100"
                                                             Value="{Binding Percent}"
                                                             IsIndeterminate="{Binding IsIndeterminate}"
                                                             Visibility="{Binding ProgressVisibility}"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="Cancel" Tag="{Binding}"
                                                            Click="CancelDownload_Click"
                                                            IsEnabled="{Binding CanCancel}" />
                                                    <Button Content="Open folder" Tag="{Binding}"
                                                            Click="OpenDownloadFolder_Click"
                                                            IsEnabled="{Binding CanOpenFolder}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="SettingsButton" Grid.Column="8" Content="Settings"
                        ToolTipService.ToolTip="Crest Windows settings">
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Width="335" Spacing="12" Loaded="SettingsPanel_Loaded">
                                <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Appearance" FontWeight="SemiBold"/>
                                <ComboBox x:Name="AppearanceCombo" HorizontalAlignment="Stretch"
                                          SelectionChanged="AppearanceCombo_SelectionChanged">
                                    <ComboBoxItem Content="Follow Windows" Tag="System"/>
                                    <ComboBoxItem Content="Light" Tag="Light"/>
                                    <ComboBoxItem Content="Dark" Tag="Dark"/>
                                </ComboBox>
                                <TextBlock Text="Changes Crest's controls, not website themes."
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="SearchSpaceText" Text="Search for this Space"
                                           FontWeight="SemiBold"/>
                                <ComboBox x:Name="SearchEngineCombo" HorizontalAlignment="Stretch"
                                          SelectionChanged="SearchEngineCombo_SelectionChanged"/>
                                <TextBlock Text="Search uses CrestCore's saved per-Space preference."
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="Keyboard shortcuts" FontWeight="SemiBold"/>
                                <TextBlock Text="Ctrl+T  New tab  ·  Ctrl+W  Close tab
Ctrl+L / Ctrl+K  Address bar  ·  Ctrl+R  Reload
Ctrl+Tab  Next tab  ·  Ctrl+Shift+Tab  Previous tab
Ctrl+J  Downloads"
                                           TextWrapping="Wrap" FontSize="12"/>
                                <TextBlock Text="Shortcuts in webpage content may be handled by WebView2."
                                           TextWrapping="Wrap" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <Grid x:Name="BrowserHost" Grid.Row="1" />
            <TextBlock x:Name="StatusText" Grid.Row="2" Text="CrestCore session preview — separate WebView2 profiles per Space"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Padding="12,5" FontSize="11"/>
        </Grid>
    </Grid>
</Window>
